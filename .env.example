# Ambiente: "local" mostra erros na tela e libera Turnstile sem chaves. Em produção, deixe "production".
APP_ENV=production
APP_URL=https://seusite.com.br

DB_HOST=127.0.0.1
DB_DATABASE=mygamelibrary
DB_USERNAME=
DB_PASSWORD=

RESEND_API_KEY=

# Cloudflare Turnstile (https://dash.cloudflare.com > Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Chaves de TESTE da Cloudflare, para desenvolvimento local (sempre passam):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Opcional: domínios de e-mail extras para bloquear (separados por vírgula)
BLOCKED_EMAIL_DOMAINS=
